// GLOBAL VARS
let player = {
  x: 90,
  y: 329,
  size: 43,
  velocityY: 0
}

let gravity = 0.8;
let jumpStrength = -11.4;

let spikes = [];
let spawnTimer = 0;
let spawnInterval = 100;
let scrollSpeed = 5

let groundY = 350;

let gameOver = false;

let music;

function preload() {
  gdBg = loadImage('gdBackground.png');
  
  music = loadSound('what-is-this-diddy-blud-doing-on-the.mp3');
}

function setup() {
  createCanvas(500, 500);
  
  music.loop();
  music.setVolume(0.5);
}

function draw() {
 
  // Stop player from falling when game is over
  if (gameOver) {
    gravity = 0;
    player.velocityY = 0; // stop the player from moving
  } else {
    gravity = 0.8;
  }

  // don't spawn when gameover
  if (!gameOver) {
    spawnTimer ++;
  }

  // Spawn logic
  if (!gameOver && spawnTimer >= spawnInterval) {
    spawnTimer = 0;

    // spike height
    let h = 30;

    // start just off the right edge
    spikes.push({ x: width + 20, w: 30, h: h });

    // spawn interval will more random
    spawnInterval = Math.floor(random(70, 110));
  }

  image(gdBg, 1, 1)
  
  // (somewhere where there's no) Gravityyyy
  player.velocityY += gravity;
  player.y += player.velocityY;
  
  // Keep player on the ground
  if (player.y > 329) {
    player.y = 329;
    player.velocityY = 0;
  }
  
  // Ground (darker version of bg)
  push();
  
  tint(0, 50, 255, 255);
  image(gdBg, 0, 350, width, 150, 0, 350, width, 150);
  
  pop();
  
  // player
  stroke(2)
  fill('white')
  circle(player.x, player.y, player.size)
  
  // spikes move left and remove off-screen ones (only if game is running)
  if (!gameOver) {
    for (let i = spikes.length - 1; i >= 0; i--) {
      spikes[i].x -= scrollSpeed;
      
      if (spikes[i].x < -100) {
        spikes.splice(i, 1);
      }
    }
  }   

  // draws spikes from the spikes array
  for (let s of spikes) {

    // triangle
    let baseRightX = s.x;
    let baseLeftX = s.x - s.w;
    let tipX = s.x - s.w / 2;
    let tipY = groundY - s.h;

    stroke('white');
    fill('black');
    triangle(baseRightX, groundY, tipX, tipY, baseLeftX, groundY);

    // player's values and stuff js look at it vv
    let half = player.size / 2;
    let playerLeft = player.x - half;
    let playerRight = player.x + half;
    let playerBottom = player.y + half;

    // spike bounding box (from the triangle values)
    let spikeLeft = baseLeftX + 10;
    let spikeRight = baseRightX - 10;
    let spikeTop = tipY + 5;

    // if player's hitbox overlaps, gameover
    if (!gameOver &&
        playerBottom > spikeTop &&
        playerRight > spikeLeft &&
        playerLeft < spikeRight) {
      gameOver = true;
      if (music && music.isPlaying()) {
        music.pause();
      }
    }
  }

  // line
  push();
  
  stroke('black');
  strokeWeight(1.2);
  line(0, 352, 500, 352);
  
  pop();
}

function mousePressed() {
  // Only jump if on the ground
  if (player.y >= 329) {
    player.velocityY = jumpStrength;
 } 
}
